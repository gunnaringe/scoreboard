{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker created by the Workers Builds import. Never rename.
  "name": "scoreboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    // Unknown paths (/j/CODE, /g/...) get index.html; the app routes client-side.
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; everything else is free static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scoreboard",
      // Placeholder: replace with the ID from `wrangler d1 create scoreboard`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    // Invite-code guesses, recovery links and group creation, per IP.
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Every change, per device: protects the account's daily D1 quotas.
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "scoreboard.apphub.casa", "custom_domain": true }
  ]
}
