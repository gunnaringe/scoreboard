{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker created by the Workers Builds import. Never rename.
  "name": "scoreboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    // Unknown paths (/j/CODE, /g/...) get index.html; the app routes client-side.
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; everything else is free static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scoreboard",
      "database_id": "b9c77a8e-76e6-4b86-8bd9-d9b83f794eac",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    // Joining, owner links and group creation, per IP. Generous: a whole
    // office joins from one IP when the poster goes up.
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    // Every change, per device: protects the account's daily D1 quotas.
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "scoreboard.apphub.casa", "custom_domain": true }
  ]
}
